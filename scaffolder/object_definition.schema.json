{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://migrate4hana.dev/schemas/object_definition.v1.json",
  "title": "Migrate4HANA Object Definition",
  "description": "Single-source-of-truth definition for one migration object. Consumed by scaffolder/build.py to generate spine, tests, and lane templates.",
  "type": "object",
  "additionalProperties": false,
  "required": ["object_type", "source_key_field", "home_table", "category", "extract", "transform", "load", "verify"],
  "properties": {
    "object_type": {
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9]+$",
      "description": "PascalCase identity. Must match an entry in the spine registry."
    },
    "source_key_field": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]+$",
      "description": "ECC primary key column (e.g., MATNR, KUNNR, BANFN)."
    },
    "home_table": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]+$",
      "description": "S/4 system-of-record table used for verify_key existence checks."
    },
    "generator": {
      "type": "string",
      "enum": ["auto", "manual"],
      "default": "auto",
      "description": "If 'manual', the scaffolder skips this object (used when handlogic doesn't fit the schema)."
    },
    "category": {
      "type": "string",
      "enum": ["Master", "Transactional", "Historical", "Configuration"]
    },
    "phase": {
      "type": "string",
      "enum": ["prepare", "explore", "realize", "post_conversion", "cutover"],
      "default": "explore"
    },

    "extract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rfc", "tables"],
      "properties": {
        "rfc": {
          "type": "string",
          "description": "RFC_READ_TABLE or a specific BAPI function module name."
        },
        "tables": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "fields"],
            "properties": {
              "name":    { "type": "string", "pattern": "^[A-Z][A-Z0-9_/]+$" },
              "fields":  { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" } },
              "where":   { "type": "string" },
              "primary": { "type": "boolean", "default": false },
              "join_on": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "package_size":          { "type": "integer", "minimum": 1, "maximum": 1000000, "default": 1000 },
        "delta_field":           { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
        "max_rows_per_template": { "type": "integer", "minimum": 1, "maximum": 5000000, "default": 50000 }
      }
    },

    "transform": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "field_maps": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "description": "source_field -> target_canonical_field mapping."
        },
        "value_maps": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          },
          "description": "target_field -> { source_value: target_value }."
        },
        "dq_gates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["field", "rule", "on_fail", "code"],
            "properties": {
              "field":     { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
              "rule":      { "type": "string", "pattern": "^[a-z][a-z0-9_]+$" },
              "rule_args": { "type": "object" },
              "on_fail":   { "type": "string", "enum": ["dead_letter", "skip", "warn"] },
              "code":      { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" }
            }
          }
        },
        "computed_fields": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "expr"],
            "properties": {
              "name": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
              "expr": { "type": "string", "description": "Python expression evaluated with row as 'row' dict." }
            }
          }
        }
      }
    },

    "fk": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[A-Z][A-Za-z0-9]+$"
      },
      "description": "source_field -> target object_type (resolved via PersistentKeyMap)."
    },

    "load": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_lane"],
      "properties": {
        "primary_lane":  { "type": "string", "enum": ["BAPI", "MC", "IDoc", "LTMOM", "BODS"] },
        "fallback_lane": { "type": "string", "enum": ["BAPI", "MC", "IDoc", "LTMOM", "BODS"] },
        "bapi": {
          "type": "object",
          "additionalProperties": false,
          "required": ["function"],
          "properties": {
            "function":            { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
            "header_struct":       { "type": "string" },
            "item_struct":         { "type": "string" },
            "extension_structure": { "type": "string" },
            "commit_with_wait":    { "type": "boolean", "default": true },
            "return_key_field":    { "type": "string", "default": "NUMBER" }
          }
        },
        "mc": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "object_id":        { "type": "string" },
            "staging_template": { "type": "string" }
          }
        },
        "idoc": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "basic_type":   { "type": "string" },
            "message_type": { "type": "string" }
          }
        },
        "ltmom": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "source_object": { "type": "string" },
            "target_object": { "type": "string" }
          }
        }
      }
    },

    "verify": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key_field"],
      "properties": {
        "key_field":    { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
        "value_fields": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" } }
      }
    },

    "extensions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "supports_ZZ_fields":  { "type": "boolean", "default": false },
        "supports_partners":   { "type": "boolean", "default": false },
        "supports_conditions": { "type": "boolean", "default": false },
        "supports_longtexts":  { "type": "boolean", "default": false }
      }
    },

    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stage_event_name": { "type": "string", "default": "data-migrator" },
        "category":         { "type": "string" },
        "affects":          { "type": "array", "items": { "type": "string" } }
      }
    },

    "version_routing": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "use_bapi":          { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
          "deprecated_fields": { "type": "array", "items": { "type": "string" } }
        }
      },
      "description": "version_code -> per-release overrides (BAPI swap + deprecated fields). version_code matches version_matrix.py."
    }
  }
}
