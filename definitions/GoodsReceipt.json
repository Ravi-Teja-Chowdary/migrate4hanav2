{
  "object_type":      "GoodsReceipt",
  "source_key_field": "MBLNR",
  "home_table":       "MKPF",
  "category":         "Transactional",
  "phase":            "explore",

  "extract": {
    "rfc": "RFC_READ_TABLE",
    "tables": [
      {
        "name":    "MKPF",
        "fields":  ["MBLNR", "MJAHR", "BUDAT", "BLDAT", "XBLNR", "USNAM"],
        "where":   "STBLG = ''",
        "primary": true
      },
      {
        "name":    "MSEG",
        "fields":  ["MBLNR", "MATNR", "WERKS", "LGORT", "BWART", "MENGE", "MEINS"],
        "join_on": ["MBLNR"]
      }
    ],
    "package_size":          500,
    "delta_field":           "BUDAT",
    "max_rows_per_template": 25000
  },

  "transform": {
    "field_maps": {
      "BUDAT": "PSTNG_DATE",
      "BLDAT": "DOC_DATE",
      "XBLNR": "REF_DOC_NO",
      "USNAM": "PR_UNAME"
    },
    "item_field_maps": {
      "MATNR": "MATERIAL",
      "WERKS": "PLANT",
      "LGORT": "STGE_LOC",
      "BWART": "MOVE_TYPE",
      "MENGE": "ENTRY_QNT",
      "MEINS": "ENTRY_UOM"
    },
    "constants_header": {
      "PSTNG_DATE": "20251115",
      "DOC_DATE":   "20251115",
      "PR_UNAME":   "MIGRATE_ADMI",
      "HEADER_TXT": "Migrated GR"
    },
    "constants_item": {
      "MATERIAL":   "TG0013",
      "PLANT":      "1710",
      "STGE_LOC":   "171A",
      "MOVE_TYPE":  "101",
      "ENTRY_QNT":  "1",
      "ENTRY_UOM":  "ST",
      "PO_NUMBER":  "4500000663",
      "PO_ITEM":    "00001"
    },
    "constants_extra": {
      "GOODSMVT_CODE": {"GM_CODE": "01"}
    },
    "dq_gates": [
      { "field": "MBLNR", "rule": "non_empty",              "on_fail": "dead_letter", "code": "MISSING_DOC_NUMBER" },
      { "field": "BUDAT", "rule": "iso_date",               "on_fail": "dead_letter", "code": "INVALID_PSTNG_DATE" },
      { "field": "BLDAT", "rule": "iso_date",               "on_fail": "dead_letter", "code": "INVALID_DOC_DATE" },
      { "field": "USNAM", "rule": "non_empty",              "on_fail": "dead_letter", "code": "MISSING_USERNAME" },
      { "field": "MATNR", "rule": "material_number_format", "on_fail": "dead_letter", "code": "INVALID_MATERIAL" },
      { "field": "WERKS", "rule": "werks_plant",            "on_fail": "dead_letter", "code": "INVALID_PLANT" },
      { "field": "BWART", "rule": "non_empty",              "on_fail": "dead_letter", "code": "MISSING_MOVE_TYPE" },
      { "field": "MENGE", "rule": "positive_number",        "on_fail": "dead_letter", "code": "INVALID_QUANTITY" },
      { "field": "MEINS", "rule": "sap_unit_of_measure",    "on_fail": "dead_letter", "code": "INVALID_UOM" }
    ]
  },

  "fk": {
    "MATNR": "Material",
    "WERKS": "Plant"
  },

  "load": {
    "primary_lane": "BAPI",
    "fallback_lane": "MC",
    "bapi": {
      "function":         "BAPI_GOODSMVT_CREATE",
      "header_struct":    "GOODSMVT_HEADER",
      "item_struct":      "GOODSMVT_ITEM",
      "extension_structure": "",
      "commit_with_wait": true,
      "return_key_field": "MATERIALDOCUMENT"
    },
    "mc": {
      "object_id":        "GOODS_RECEIPT",
      "staging_template": "S_GOODS_RECEIPT"
    },
    "idoc": {
      "basic_type":   "WMMBID02",
      "message_type": "WMMBXY"
    },
    "ltmom": {
      "source_object": "S_GR_HEADER",
      "target_object": "MBLNR"
    }
  },

  "verify": {
    "key_field":    "MBLNR",
    "value_fields": ["BUDAT", "USNAM"]
  },

  "extensions": {
    "supports_ZZ_fields":  false,
    "supports_partners":   false,
    "supports_conditions": false,
    "supports_longtexts":  false
  },

  "telemetry": {
    "category": "InventoryReadiness",
    "affects":  ["GoodsReceipt"]
  },

  "version_routing": {
    "S4HANA_2020": { "use_bapi": "BAPI_GOODSMVT_CREATE" },
    "S4HANA_2022": { "use_bapi": "BAPI_GOODSMVT_CREATE" }
  }
}
