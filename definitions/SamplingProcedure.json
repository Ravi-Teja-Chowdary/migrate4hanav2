{
  "object_type":      "SamplingProcedure",
  "source_key_field": "PROBENART",
  "home_table":       "QPRS",
  "category":         "Master",
  "phase":            "explore",

  "extract": {
    "rfc": "RFC_READ_TABLE",
    "tables": [
      {
        "name":    "QPRS",
        "fields":  ["PROBENART", "PROBENART_TXT", "STICHPRART", "BEWERTART"],
        "where":   "LOEKZ <> 'X'",
        "primary": true
      }
    ],
    "package_size":          500,
    "max_rows_per_template": 25000
  },

  "transform": {
    "field_maps": {
      "PROBENART_TXT": "DESCRIPTION",
      "STICHPRART":    "SAMPLE_TYPE",
      "BEWERTART":     "VALUATION_TYPE"
    },
    "item_field_maps": {},
    "dq_gates": [
      { "field": "PROBENART",     "rule": "non_empty", "on_fail": "dead_letter", "code": "MISSING_PROC_NO" },
      { "field": "PROBENART_TXT", "rule": "non_empty", "on_fail": "dead_letter", "code": "MISSING_DESCRIPTION" }
    ]
  },

  "fk": {},

  "load": {
    "primary_lane": "MC",
    "bapi": {
      "function":         "BAPI_QPMK_CREATE",
      "header_struct":    "SAMPL_PROC",
      "extension_structure": "",
      "commit_with_wait": true,
      "return_key_field": "PROBENART"
    },
    "mc": {
      "object_id":        "SAMPLING_PROCEDURE",
      "staging_template": "S_SAMPLING_PROCEDURE"
    },
    "ltmom": {
      "source_object": "S_SMPL_PROC_HEADER",
      "target_object": "PROBENART"
    }
  },

  "verify": {
    "key_field":    "PROBENART",
    "value_fields": ["PROBENART_TXT", "STICHPRART"]
  },

  "extensions": { "supports_ZZ_fields": false, "supports_partners": false, "supports_conditions": false, "supports_longtexts": false },
  "telemetry": { "category": "QMReadiness", "affects": ["SamplingProcedure"] },
  "version_routing": {
    "S4HANA_2020": { "use_bapi": "BAPI_QPMK_CREATE" },
    "S4HANA_2022": { "use_bapi": "BAPI_QPMK_CREATE" }
  }
}
