{
  "object_type":      "Requirement",
  "source_key_field": "MATNR",
  "home_table":       "PBIM",
  "category":         "Transactional",
  "phase":            "explore",

  "extract": {
    "rfc": "RFC_READ_TABLE",
    "tables": [
      {
        "name":    "PBIM",
        "fields":  ["MATNR", "WERKS", "BDZEI", "VERSB", "PLNMG", "MEINS"],
        "where":   "LOEVM <> 'X'",
        "primary": true
      }
    ],
    "package_size":          500,
    "max_rows_per_template": 10000
  },

  "transform": {
    "field_maps": {
      "MATNR": "MATERIAL",
      "WERKS": "PLANT",
      "VERSB": "VERSION"
    },
    "constants_header": {
      "MATERIAL":     "TG0013",
      "PLANT":        "1710",
      "VERSION":      "00",
      "REQU_TYPE":    "VSF",
      "VERS_ACTIV":   "X"
    },
    "constants_extra": {
      "REQUIREMENT_PARAM": {
        "TRTYP":   "I",
        "STATUS":  "AKT",
        "UPDDC":   "X",
        "COMMI":   "X"
      },
      "DO_COMMIT": "X"
    },
    "extra_payload": {
      "REQUIREMENTS_SCHEDULE_IN": [{
        "REQ_DATE":  "20251215",
        "REQ_QTY":   "1",
        "UNIT":      "ST",
        "DATE_TYPE": "T"
      }]
    },
    "dq_gates": [
      { "field": "MATNR", "rule": "material_number_format", "on_fail": "dead_letter", "code": "INVALID_MATERIAL" },
      { "field": "WERKS", "rule": "werks_plant",            "on_fail": "dead_letter", "code": "INVALID_PLANT" },
      { "field": "PLNMG", "rule": "positive_number",        "on_fail": "dead_letter", "code": "INVALID_QUANTITY" }
    ]
  },

  "fk": {
    "MATNR": "Material",
    "WERKS": "Plant"
  },

  "load": {
    "primary_lane": "BAPI",
    "fallback_lane": "MC",
    "bapi": {
      "function":         "BAPI_REQUIREMENTS_CREATE",
      "header_struct":    "REQUIREMENTS_ITEM",
      "extension_structure": "",
      "commit_with_wait": true,
      "return_key_field": "REQMTSPLANNUMBER"
    },
    "mc": {
      "object_id":        "REQUIREMENT",
      "staging_template": "S_REQUIREMENT"
    },
    "ltmom": {
      "source_object": "S_REQ_HEADER",
      "target_object": "MATNR"
    }
  },

  "verify": {
    "key_field":    "MATNR",
    "value_fields": ["WERKS", "PLNMG"]
  },

  "extensions": {
    "supports_ZZ_fields":  false,
    "supports_partners":   false,
    "supports_conditions": false,
    "supports_longtexts":  false
  },

  "telemetry": {
    "category": "PlanningReadiness",
    "affects":  ["Requirement"]
  },

  "version_routing": {
    "S4HANA_2020": { "use_bapi": "BAPI_REQUIREMENTS_CREATE" },
    "S4HANA_2022": { "use_bapi": "BAPI_REQUIREMENTS_CREATE" }
  }
}
