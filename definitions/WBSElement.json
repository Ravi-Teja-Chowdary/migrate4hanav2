{
  "object_type":      "WBSElement",
  "source_key_field": "POSID",
  "home_table":       "PRPS",
  "category":         "Master",
  "phase":            "explore",

  "extract": {
    "rfc": "RFC_READ_TABLE",
    "tables": [
      {
        "name":    "PRPS",
        "fields":  ["PSPNR", "POSID", "POST1", "PSPHI", "PRART"],
        "where":   "LOEKZ <> 'X'",
        "primary": true
      }
    ],
    "package_size":          500,
    "max_rows_per_template": 10000
  },

  "transform": {
    "field_maps": {
      "POST1": "DESCRIPTION"
    },
    "item_field_maps": {
      "POSID": "WBS_ELEMENT",
      "PRART": "PROJECT_TYPE"
    },
    "dq_gates": [
      { "field": "POSID", "rule": "non_empty", "on_fail": "dead_letter", "code": "MISSING_WBS_ID" },
      { "field": "POST1", "rule": "non_empty", "on_fail": "dead_letter", "code": "MISSING_DESCRIPTION" }
    ]
  },

  "fk": {},

  "load": {
    "primary_lane": "BAPI",
    "fallback_lane": "MC",
    "bapi": {
      "function":         "BAPI_BUS2054_CREATE_MULTI",
      "header_struct":    "I_PROJECT_DEFINITION",
      "header_is_scalar": true,
      "item_struct":      "IT_WBS_ELEMENT",
      "extension_structure": "",
      "commit_with_wait": true,
      "return_key_field": "ET_RETURN"
    },
    "mc": {
      "object_id":        "WBS_ELEMENT",
      "staging_template": "S_WBS_ELEMENT"
    },
    "ltmom": {
      "source_object": "S_WBS_HEADER",
      "target_object": "POSID"
    }
  },

  "verify": {
    "key_field":    "POSID",
    "value_fields": ["POST1", "PRART"]
  },

  "extensions": {
    "supports_ZZ_fields":  false,
    "supports_partners":   false,
    "supports_conditions": false,
    "supports_longtexts":  false
  },

  "telemetry": {
    "category": "ProjectSystemReadiness",
    "affects":  ["WBSElement"]
  },

  "version_routing": {
    "S4HANA_2020": { "use_bapi": "BAPI_BUS2054_CREATE_MULTI" },
    "S4HANA_2022": { "use_bapi": "BAPI_BUS2054_CREATE_MULTI" }
  }
}
