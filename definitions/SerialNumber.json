{
  "object_type":      "SerialNumber",
  "source_key_field": "SERNR",
  "home_table":       "EQUI",
  "category":         "Master",
  "phase":            "explore",

  "extract": {
    "rfc": "RFC_READ_TABLE",
    "tables": [
      {
        "name":    "OBJK",
        "fields":  ["SERNR", "MATNR", "EQUNR", "LAGERORT", "WERK"],
        "where":   "TASER = 'EQUI'",
        "primary": true
      }
    ],
    "package_size":          500,
    "max_rows_per_template": 25000
  },

  "transform": {
    "field_maps": {
      "SERNR": "DESCRIPT"
    },
    "item_field_maps": {},
    "dq_gates": [
      { "field": "SERNR", "rule": "non_empty",              "on_fail": "dead_letter", "code": "MISSING_SERIAL" },
      { "field": "MATNR", "rule": "material_number_format", "on_fail": "dead_letter", "code": "INVALID_MATERIAL" }
    ]
  },

  "fk": {
    "MATNR": "Material"
  },

  "load": {
    "primary_lane": "BAPI",
    "fallback_lane": "MC",
    "bapi": {
      "function":         "BAPI_EQUI_CREATE",
      "header_struct":    "DATA_GENERAL",
      "extension_structure": "",
      "commit_with_wait": true,
      "return_key_field": "EQUIPMENT"
    },
    "mc": {
      "object_id":        "SERIAL_NUMBER",
      "staging_template": "S_SERIAL_NUMBER"
    },
    "ltmom": {
      "source_object": "S_SERIAL_HEADER",
      "target_object": "SERNR"
    }
  },

  "verify": {
    "key_field":    "SERNR",
    "value_fields": ["MATNR"]
  },

  "extensions": {
    "supports_ZZ_fields":  false,
    "supports_partners":   false,
    "supports_conditions": false,
    "supports_longtexts":  false
  },

  "telemetry": {
    "category": "MasterDataReadiness",
    "affects":  ["SerialNumber"]
  },

  "version_routing": {
    "S4HANA_2020": { "use_bapi": "BAPI_EQUI_CREATE" },
    "S4HANA_2022": { "use_bapi": "BAPI_EQUI_CREATE" }
  }
}
