{
  "object_type":      "HRMaster",
  "source_key_field": "OBJID",
  "home_table":       "HRP1000",
  "category":         "Master",
  "phase":            "explore",

  "extract": {
    "rfc": "RFC_READ_TABLE",
    "tables": [
      {
        "name":    "HRP1000",
        "fields":  ["PLVAR", "OTYPE", "OBJID", "ISTAT"],
        "where":   "ISTAT = '1'",
        "primary": true
      }
    ],
    "package_size":          500,
    "max_rows_per_template": 10000
  },

  "transform": {
    "field_maps": {},
    "item_field_maps": {
      "PLVAR": "PLAN_VER",
      "OTYPE": "OBJ_TYPE",
      "OBJID": "OBJ_ID"
    },
    "dq_gates": [
      { "field": "PLVAR", "rule": "non_empty", "on_fail": "dead_letter", "code": "MISSING_PLAN_VERSION" },
      { "field": "OTYPE", "rule": "non_empty", "on_fail": "dead_letter", "code": "MISSING_OBJECT_TYPE" },
      { "field": "OBJID", "rule": "non_empty", "on_fail": "dead_letter", "code": "MISSING_OBJECT_ID" }
    ]
  },

  "fk": {},

  "load": {
    "primary_lane": "BAPI",
    "fallback_lane": "MC",
    "bapi": {
      "function":         "BAPI_HRMASTER_SAVE_REPL_MULT",
      "header_struct":    "",
      "item_struct":      "HR_OBJECT_HEADER",
      "extension_structure": "",
      "commit_with_wait": true,
      "return_key_field": "OBJ_ID"
    },
    "mc": {
      "object_id":        "HR_MASTER",
      "staging_template": "S_HR_MASTER"
    },
    "ltmom": {
      "source_object": "S_HR_MASTER_HEADER",
      "target_object": "OBJID"
    }
  },

  "verify": {
    "key_field":    "OBJID",
    "value_fields": ["PLVAR", "OTYPE"]
  },

  "extensions": {
    "supports_ZZ_fields":  false,
    "supports_partners":   false,
    "supports_conditions": false,
    "supports_longtexts":  false
  },

  "telemetry": {
    "category": "HRReadiness",
    "affects":  ["HRMaster"]
  },

  "version_routing": {
    "S4HANA_2020": { "use_bapi": "BAPI_HRMASTER_SAVE_REPL_MULT" },
    "S4HANA_2022": { "use_bapi": "BAPI_HRMASTER_SAVE_REPL_MULT" }
  }
}
