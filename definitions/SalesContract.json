{
  "object_type":      "SalesContract",
  "source_key_field": "VBELN",
  "home_table":       "VBAK",
  "category":         "Transactional",
  "phase":            "explore",

  "extract": {
    "rfc": "RFC_READ_TABLE",
    "tables": [
      {
        "name":    "VBAK",
        "fields":  ["VBELN", "AUART", "VKORG", "VTWEG", "SPART", "WAERK"],
        "where":   "AUART IN ('CQ', 'WV') AND ABSTK <> 'C'",
        "primary": true
      }
    ],
    "package_size":          500,
    "max_rows_per_template": 25000
  },

  "transform": {
    "field_maps": {
      "AUART": "DOC_TYPE",
      "VKORG": "SALES_ORG",
      "VTWEG": "DISTR_CHAN",
      "SPART": "DIVISION",
      "WAERK": "CURRENCY"
    },
    "item_field_maps": {},
    "dq_gates": [
      { "field": "VBELN", "rule": "non_empty", "on_fail": "dead_letter", "code": "MISSING_CONTRACT_NO" },
      { "field": "AUART", "rule": "non_empty", "on_fail": "dead_letter", "code": "MISSING_DOC_TYPE" },
      { "field": "VKORG", "rule": "non_empty", "on_fail": "dead_letter", "code": "MISSING_SALES_ORG" }
    ]
  },

  "fk": {},

  "load": {
    "primary_lane": "MC",
    "bapi": {
      "function":         "BAPI_SALESCONTRACT_CREATEFROMDATA",
      "header_struct":    "CONTRACT_HEADER_IN",
      "extension_structure": "",
      "commit_with_wait": true,
      "return_key_field": "SALESDOCUMENT"
    },
    "mc": {
      "object_id":        "SALES_CONTRACT",
      "staging_template": "S_SALES_CONTRACT"
    },
    "ltmom": {
      "source_object": "S_SALES_CONTRACT_HEADER",
      "target_object": "VBELN"
    }
  },

  "verify": {
    "key_field":    "VBELN",
    "value_fields": ["AUART", "VKORG"]
  },

  "extensions": { "supports_ZZ_fields": false, "supports_partners": true, "supports_conditions": true, "supports_longtexts": false },
  "telemetry": { "category": "SDReadiness", "affects": ["SalesContract"] },
  "version_routing": {
    "S4HANA_2020": { "use_bapi": "BAPI_SALESCONTRACT_CREATEFROMDATA" },
    "S4HANA_2022": { "use_bapi": "BAPI_SALESCONTRACT_CREATEFROMDATA" }
  }
}
