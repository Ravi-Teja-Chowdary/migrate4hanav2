{
  "object_type":      "StockTransferOrder",
  "source_key_field": "EBELN",
  "home_table":       "EKKO",
  "category":         "Transactional",
  "phase":            "explore",

  "extract": {
    "rfc": "RFC_READ_TABLE",
    "tables": [
      {
        "name":    "EKKO",
        "fields":  ["EBELN", "BSART", "LIFNR", "EKORG", "EKGRP", "WAERS"],
        "where":   "BSART = 'UB' AND LOEKZ <> 'X'",
        "primary": true
      }
    ],
    "package_size":          500,
    "max_rows_per_template": 25000
  },

  "transform": {
    "field_maps": {
      "BSART": "DOC_TYPE",
      "EKORG": "PURCH_ORG",
      "EKGRP": "PUR_GROUP",
      "WAERS": "CURRENCY"
    },
    "item_field_maps": {},
    "constants_header": {
      "PURCH_ORG":   "1710",
      "PUR_GROUP":   "001",
      "CURRENCY":    "USD",
      "DOC_TYPE":    "UB",
      "DOC_DATE":    "20260615",
      "SUPPL_PLNT":  "1010",
      "COMP_CODE":   "1710"
    },
    "constants_item": {
      "PO_ITEM":     "00010",
      "MATERIAL":    "TG0013",
      "PLANT":       "1710",
      "QUANTITY":    "1",
      "PO_UNIT":     "EA"
    },
    "dq_gates": [
      { "field": "EBELN", "rule": "non_empty", "on_fail": "dead_letter", "code": "MISSING_PO_NUMBER" },
      { "field": "BSART", "rule": "in_set", "rule_args": {"values": ["UB"]}, "on_fail": "dead_letter", "code": "INVALID_DOC_TYPE" },
      { "field": "EKORG", "rule": "non_empty", "on_fail": "dead_letter", "code": "MISSING_PURCH_ORG" }
    ]
  },

  "fk": {},

  "load": {
    "primary_lane": "BAPI",
    "fallback_lane": "MC",
    "bapi": {
      "function":         "BAPI_PO_CREATE1",
      "header_struct":    "POHEADER",
      "headerx_struct":   "POHEADERX",
      "item_struct":      "POITEM",
      "itemx_struct":     "POITEMX",
      "extension_structure": "",
      "commit_with_wait": true,
      "return_key_field": "EXPPURCHASEORDER"
    },
    "mc": {
      "object_id":        "STOCK_TRANSFER_ORDER",
      "staging_template": "S_STOCK_TRANSFER_ORDER"
    },
    "ltmom": {
      "source_object": "S_STO_HEADER",
      "target_object": "EBELN"
    }
  },

  "verify": {
    "key_field":    "EBELN",
    "value_fields": ["BSART", "EKORG"]
  },

  "extensions": {
    "supports_ZZ_fields":  false,
    "supports_partners":   false,
    "supports_conditions": false,
    "supports_longtexts":  false
  },

  "telemetry": {
    "category": "MMReadiness",
    "affects":  ["StockTransferOrder"]
  },

  "version_routing": {
    "S4HANA_2020": { "use_bapi": "BAPI_PO_CREATE1" },
    "S4HANA_2022": { "use_bapi": "BAPI_PO_CREATE1" }
  }
}
