{
  "object_type":      "ScheduleAgreementMM",
  "source_key_field": "EBELN",
  "home_table":       "EKKO",
  "category":         "Transactional",
  "phase":            "explore",

  "extract": {
    "rfc": "RFC_READ_TABLE",
    "tables": [
      {
        "name":    "EKKO",
        "fields":  ["EBELN", "BSART", "LIFNR", "EKORG", "EKGRP", "WAERS"],
        "where":   "BSART IN ('LP', 'LPA') AND LOEKZ <> 'X'",
        "primary": true
      }
    ],
    "package_size":          500,
    "max_rows_per_template": 25000
  },

  "transform": {
    "field_maps": {
      "BSART": "DOC_TYPE",
      "EKORG": "PURCH_ORG",
      "EKGRP": "PUR_GROUP",
      "WAERS": "CURRENCY"
    },
    "item_field_maps": {},
    "dq_gates": [
      { "field": "EBELN", "rule": "non_empty", "on_fail": "dead_letter", "code": "MISSING_AGREEMENT_NO" },
      { "field": "BSART", "rule": "in_set", "rule_args": {"values": ["LP","LPA"]}, "on_fail": "dead_letter", "code": "INVALID_DOC_TYPE" },
      { "field": "EKORG", "rule": "non_empty", "on_fail": "dead_letter", "code": "MISSING_PURCH_ORG" }
    ]
  },

  "fk": {},

  "load": {
    "primary_lane": "BAPI",
    "fallback_lane": "MC",
    "bapi": {
      "function":         "BAPI_SAG_CREATE",
      "header_struct":    "HEADER",
      "extension_structure": "",
      "commit_with_wait": true,
      "return_key_field": "PURCHASINGDOCUMENT"
    },
    "mc": {
      "object_id":        "SCHEDULE_AGREEMENT_MM",
      "staging_template": "S_SCHEDULE_AGREEMENT_MM"
    },
    "ltmom": {
      "source_object": "S_SAG_MM_HEADER",
      "target_object": "EBELN"
    }
  },

  "verify": {
    "key_field":    "EBELN",
    "value_fields": ["BSART", "EKORG"]
  },

  "extensions": {
    "supports_ZZ_fields":  false,
    "supports_partners":   false,
    "supports_conditions": false,
    "supports_longtexts":  false
  },

  "telemetry": {
    "category": "MMReadiness",
    "affects":  ["ScheduleAgreementMM"]
  },

  "version_routing": {
    "S4HANA_2020": { "use_bapi": "BAPI_SAG_CREATE" },
    "S4HANA_2022": { "use_bapi": "BAPI_SAG_CREATE" }
  }
}
