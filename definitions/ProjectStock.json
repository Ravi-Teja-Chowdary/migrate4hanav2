{
  "object_type":      "ProjectStock",
  "source_key_field": "PSPNR",
  "home_table":       "MSPR",
  "category":         "Master",
  "phase":            "explore",

  "extract": {
    "rfc": "RFC_READ_TABLE",
    "tables": [
      {
        "name":    "MSPR",
        "fields":  ["MATNR", "WERKS", "PSPNR", "PSPEL", "SOBKZ", "PSPNR_PSP"],
        "where":   "SOBKZ = 'Q'",
        "primary": true
      }
    ],
    "package_size":          500,
    "max_rows_per_template": 25000
  },

  "transform": {
    "field_maps": {
      "MATNR": "MATERIAL",
      "WERKS": "PLANT",
      "PSPEL": "WBS_ELEMENT"
    },
    "item_field_maps": {},
    "dq_gates": [
      { "field": "PSPNR", "rule": "non_empty",              "on_fail": "dead_letter", "code": "MISSING_PROJECT" },
      { "field": "MATNR", "rule": "material_number_format", "on_fail": "dead_letter", "code": "INVALID_MATERIAL" }
    ]
  },

  "fk": { "MATNR": "Material" },

  "load": {
    "primary_lane": "MC",
    "bapi": {
      "function":         "BAPI_PROJECT_STOCK_CREATE",
      "header_struct":    "PROJECT_STOCK",
      "extension_structure": "",
      "commit_with_wait": true,
      "return_key_field": "PSPNR"
    },
    "mc": {
      "object_id":        "PROJECT_STOCK",
      "staging_template": "S_PROJECT_STOCK"
    },
    "ltmom": {
      "source_object": "S_PROJECT_STOCK_HEADER",
      "target_object": "PSPNR"
    }
  },

  "verify": {
    "key_field":    "PSPNR",
    "value_fields": ["MATNR", "WERKS"]
  },

  "extensions": { "supports_ZZ_fields": false, "supports_partners": false, "supports_conditions": false, "supports_longtexts": false },
  "telemetry": { "category": "ProjectSystemReadiness", "affects": ["ProjectStock"] },
  "version_routing": {
    "S4HANA_2020": { "use_bapi": "BAPI_PROJECT_STOCK_CREATE" },
    "S4HANA_2022": { "use_bapi": "BAPI_PROJECT_STOCK_CREATE" }
  }
}
