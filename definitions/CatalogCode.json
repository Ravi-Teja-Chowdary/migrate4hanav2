{
  "object_type":      "CatalogCode",
  "source_key_field": "CODEGRUPPE",
  "home_table":       "QPGT",
  "category":         "Master",
  "phase":            "explore",

  "extract": {
    "rfc": "RFC_READ_TABLE",
    "tables": [
      {
        "name":    "QPGT",
        "fields":  ["KATALOGART", "CODEGRUPPE", "KURZTEXT", "STATUS"],
        "where":   "LOEKZ <> 'X'",
        "primary": true
      }
    ],
    "package_size":          500,
    "max_rows_per_template": 25000
  },

  "transform": {
    "field_maps": {
      "KATALOGART": "CATALOG",
      "KURZTEXT":   "DESCRIPTION",
      "STATUS":     "STATUS"
    },
    "item_field_maps": {},
    "dq_gates": [
      { "field": "CODEGRUPPE", "rule": "non_empty", "on_fail": "dead_letter", "code": "MISSING_CODE_GROUP" },
      { "field": "KATALOGART", "rule": "non_empty", "on_fail": "dead_letter", "code": "MISSING_CATALOG" }
    ]
  },

  "fk": {},

  "load": {
    "primary_lane": "MC",
    "bapi": {
      "function":         "BAPI_BUS2055_CREATE",
      "header_struct":    "CATALOG_CODE",
      "extension_structure": "",
      "commit_with_wait": true,
      "return_key_field": "CODEGRUPPE"
    },
    "mc": {
      "object_id":        "CATALOG_CODE",
      "staging_template": "S_CATALOG_CODE"
    },
    "ltmom": {
      "source_object": "S_CATCODE_HEADER",
      "target_object": "CODEGRUPPE"
    }
  },

  "verify": {
    "key_field":    "CODEGRUPPE",
    "value_fields": ["KATALOGART", "KURZTEXT"]
  },

  "extensions": { "supports_ZZ_fields": false, "supports_partners": false, "supports_conditions": false, "supports_longtexts": false },
  "telemetry": { "category": "QMReadiness", "affects": ["CatalogCode"] },
  "version_routing": {
    "S4HANA_2020": { "use_bapi": "BAPI_BUS2055_CREATE" },
    "S4HANA_2022": { "use_bapi": "BAPI_BUS2055_CREATE" }
  }
}
