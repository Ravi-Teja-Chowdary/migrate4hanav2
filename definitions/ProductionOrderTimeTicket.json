{
  "object_type":      "ProductionOrderTimeTicket",
  "source_key_field": "RUECK",
  "home_table":       "AFRU",
  "category":         "Transactional",
  "phase":            "explore",

  "extract": {
    "rfc": "RFC_READ_TABLE",
    "tables": [
      {
        "name":    "AFRU",
        "fields":  ["RUECK", "AUFNR", "VORNR", "BUDAT", "ISMNW", "ISMNE"],
        "where":   "STOKZ <> 'X' AND STZHL = '0'",
        "primary": true
      }
    ],
    "package_size":          500,
    "delta_field":           "BUDAT",
    "max_rows_per_template": 25000
  },

  "transform": {
    "field_maps": {},
    "item_field_maps": {
      "RUECK": "CONF_NO",
      "AUFNR": "ORDERID",
      "VORNR": "OPERATION",
      "BUDAT": "POSTG_DATE"
    },
    "dq_gates": [
      { "field": "RUECK", "rule": "non_empty", "on_fail": "dead_letter", "code": "MISSING_CONF_NO" },
      { "field": "AUFNR", "rule": "non_empty", "on_fail": "dead_letter", "code": "MISSING_ORDER" },
      { "field": "VORNR", "rule": "non_empty", "on_fail": "dead_letter", "code": "MISSING_OPERATION" },
      { "field": "BUDAT", "rule": "iso_date",  "on_fail": "dead_letter", "code": "INVALID_POSTG_DATE" }
    ]
  },

  "fk": {},

  "load": {
    "primary_lane": "BAPI",
    "fallback_lane": "MC",
    "bapi": {
      "function":         "BAPI_PRODORDCONF_CREATE_TT",
      "header_struct":    "",
      "item_struct":      "TIMETICKETS",
      "extension_structure": "",
      "commit_with_wait": true,
      "return_key_field": "CONF_NO"
    },
    "mc": {
      "object_id":        "PROD_ORDER_TIME_TICKET",
      "staging_template": "S_PROD_TIME_TICKET"
    },
    "ltmom": {
      "source_object": "S_TIME_TICKET_HEADER",
      "target_object": "RUECK"
    }
  },

  "verify": {
    "key_field":    "RUECK",
    "value_fields": ["AUFNR", "VORNR"]
  },

  "extensions": {
    "supports_ZZ_fields":  false,
    "supports_partners":   false,
    "supports_conditions": false,
    "supports_longtexts":  false
  },

  "telemetry": {
    "category": "ManufacturingReadiness",
    "affects":  ["ProductionOrderTimeTicket"]
  },

  "version_routing": {
    "S4HANA_2020": { "use_bapi": "BAPI_PRODORDCONF_CREATE_TT" },
    "S4HANA_2022": { "use_bapi": "BAPI_PRODORDCONF_CREATE_TT" }
  }
}
