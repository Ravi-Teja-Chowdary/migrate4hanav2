{
  "object_type":      "ServiceMaster",
  "source_key_field": "ASNUM",
  "home_table":       "ASMD",
  "category":         "Master",
  "phase":            "explore",

  "extract": {
    "rfc": "RFC_READ_TABLE",
    "tables": [
      {
        "name":    "ASMD",
        "fields":  ["ASNUM", "MATKL", "BASME", "ASKTX", "MEINS"],
        "where":   "LVORM <> 'X'",
        "primary": true
      }
    ],
    "package_size":          1000,
    "max_rows_per_template": 50000
  },

  "transform": {
    "field_maps": {
      "ASNUM": "SERVICE",
      "MATKL": "MATL_GROUP",
      "BASME": "BASE_UOM",
      "MEINS": "BASE_UOM_ISO"
    },
    "constants_header": {
      "BASE_UOM":    "EA",
      "SERVICE":     "",
      "MATL_GROUP":  "L001",
      "SERV_TYPE":   "DIEN"
    },
    "extra_payload": {
      "IM_SERVICE_DATAX": {
        "BASE_UOM":    "X",
        "MATL_GROUP":  "X",
        "SERV_TYPE":   "X"
      },
      "SERVICE_DESCRIPTION": [{
        "LANGUAGE":      "E",
        "LANGUAGE_ISO":  "EN",
        "SHORT_TEXT":    "Migrated service"
      }]
    },
    "dq_gates": [
      { "field": "ASNUM", "rule": "non_empty",            "on_fail": "dead_letter", "code": "MISSING_SERVICE_NUMBER" },
      { "field": "BASME", "rule": "sap_unit_of_measure",  "on_fail": "dead_letter", "code": "INVALID_BASE_UOM" }
    ]
  },

  "fk": {},

  "load": {
    "primary_lane": "BAPI",
    "fallback_lane": "MC",
    "bapi": {
      "function":         "BAPI_SERVICE_CREATE",
      "header_struct":    "IM_SERVICE_DATA",
      "extension_structure": "BAPI_TE_ASMD",
      "commit_with_wait": true,
      "return_key_field": "SERVICE"
    },
    "mc": {
      "object_id":        "SERVICE_MASTER",
      "staging_template": "S_SERVICE_MASTER"
    },
    "ltmom": {
      "source_object": "S_SVCMASTER_HEADER",
      "target_object": "ASNUM"
    }
  },

  "verify": {
    "key_field":    "ASNUM",
    "value_fields": ["MATKL", "BASME"]
  },

  "extensions": {
    "supports_ZZ_fields":  true,
    "supports_partners":   false,
    "supports_conditions": false,
    "supports_longtexts":  true
  },

  "telemetry": {
    "category": "ServiceMasterReadiness",
    "affects":  ["ServiceMaster", "ServiceEntrySheet"]
  },

  "version_routing": {
    "S4HANA_2020": { "use_bapi": "BAPI_SERVICE_CREATE" },
    "S4HANA_2022": { "use_bapi": "BAPI_SERVICE_CREATE" }
  }
}
