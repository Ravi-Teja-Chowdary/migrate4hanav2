{
  "object_type":      "HandlingUnit",
  "source_key_field": "EXIDV",
  "home_table":       "VEKP",
  "category":         "Transactional",
  "phase":            "explore",

  "extract": {
    "rfc": "RFC_READ_TABLE",
    "tables": [
      {
        "name":    "VEKP",
        "fields":  ["VENUM", "EXIDV", "VHILM", "BRGEW", "NTGEW", "GEWEI"],
        "where":   "LOEKZ <> 'X'",
        "primary": true
      }
    ],
    "package_size":          500,
    "max_rows_per_template": 10000
  },

  "transform": {
    "field_maps": {
      "EXIDV": "HU_EXID",
      "VHILM": "PACK_MAT",
      "BRGEW": "TOTAL_WGHT",
      "GEWEI": "UNIT_OF_WT"
    },
    "constants_header": {
      "PACK_MAT":    "EWMS4-CAR00",
      "PLANT":       "1710",
      "STGE_LOC":    "171A",
      "UNIT_OF_WT":  "KG",
      "HU_EXID":     ""
    },
    "dq_gates": [
      { "field": "EXIDV", "rule": "non_empty", "on_fail": "dead_letter", "code": "MISSING_HU_EXID" },
      { "field": "VHILM", "rule": "material_number_format", "on_fail": "dead_letter", "code": "INVALID_PACK_MAT" },
      { "field": "BRGEW", "rule": "positive_number", "on_fail": "dead_letter", "code": "INVALID_WEIGHT" }
    ]
  },

  "fk": {
    "VHILM": "Material"
  },

  "load": {
    "primary_lane": "BAPI",
    "fallback_lane": "MC",
    "bapi": {
      "function":         "BAPI_HU_CREATE",
      "header_struct":    "HEADERPROPOSAL",
      "extension_structure": "",
      "commit_with_wait": true,
      "return_key_field": "HUKEY"
    },
    "mc": {
      "object_id":        "HANDLING_UNIT",
      "staging_template": "S_HANDLING_UNIT"
    },
    "ltmom": {
      "source_object": "S_HANDLING_UNIT_HEADER",
      "target_object": "EXIDV"
    }
  },

  "verify": {
    "key_field":    "EXIDV",
    "value_fields": ["VHILM", "BRGEW"]
  },

  "extensions": {
    "supports_ZZ_fields":  false,
    "supports_partners":   false,
    "supports_conditions": false,
    "supports_longtexts":  false
  },

  "telemetry": {
    "category": "LogisticsReadiness",
    "affects":  ["HandlingUnit"]
  },

  "version_routing": {
    "S4HANA_2020": { "use_bapi": "BAPI_HU_CREATE" },
    "S4HANA_2022": { "use_bapi": "BAPI_HU_CREATE" }
  }
}
