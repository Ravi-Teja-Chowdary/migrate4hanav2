{
  "object_type":      "NetworkActivity",
  "source_key_field": "AUFNR",
  "home_table":       "AFVC",
  "category":         "Transactional",
  "phase":            "explore",

  "extract": {
    "rfc": "RFC_READ_TABLE",
    "tables": [
      {
        "name":    "AFVC",
        "fields":  ["AUFPL", "APLZL", "VORNR", "LTXA1", "ARBID"],
        "where":   "LOEKZ <> 'X'",
        "primary": true
      }
    ],
    "package_size":          500,
    "max_rows_per_template": 25000
  },

  "transform": {
    "field_maps": {
      "AUFNR": "NETWORK"
    },
    "item_field_maps": {
      "VORNR": "ACTIVITY",
      "LTXA1": "DESCRIPTION"
    },
    "dq_gates": [
      { "field": "AUFNR", "rule": "non_empty", "on_fail": "dead_letter", "code": "MISSING_NETWORK" },
      { "field": "VORNR", "rule": "non_empty", "on_fail": "dead_letter", "code": "MISSING_ACTIVITY_NO" },
      { "field": "LTXA1", "rule": "non_empty", "on_fail": "dead_letter", "code": "MISSING_DESCRIPTION" }
    ]
  },

  "fk": {},

  "load": {
    "primary_lane": "BAPI",
    "fallback_lane": "MC",
    "bapi": {
      "function":         "BAPI_NETWORK_MAINTAIN",
      "header_struct":    "",
      "item_struct":      "I_ACTIVITY",
      "extension_structure": "",
      "commit_with_wait": true,
      "return_key_field": "RETURN"
    },
    "mc": {
      "object_id":        "NETWORK_ACTIVITY",
      "staging_template": "S_NETWORK_ACTIVITY"
    },
    "ltmom": {
      "source_object": "S_NETWORK_ACT_HEADER",
      "target_object": "AUFNR"
    }
  },

  "verify": {
    "key_field":    "AUFNR",
    "value_fields": ["VORNR", "LTXA1"]
  },

  "extensions": {
    "supports_ZZ_fields":  false,
    "supports_partners":   false,
    "supports_conditions": false,
    "supports_longtexts":  false
  },

  "telemetry": {
    "category": "ProjectSystemReadiness",
    "affects":  ["NetworkActivity"]
  },

  "version_routing": {
    "S4HANA_2020": { "use_bapi": "BAPI_NETWORK_MAINTAIN" },
    "S4HANA_2022": { "use_bapi": "BAPI_NETWORK_MAINTAIN" }
  }
}
