{
  "object_type":      "BatchClassification",
  "source_key_field": "CHARG",
  "home_table":       "AUSP",
  "category":         "Master",
  "phase":            "explore",

  "extract": {
    "rfc": "RFC_READ_TABLE",
    "tables": [
      {
        "name":    "AUSP",
        "fields":  ["OBJEK", "ATINN", "ATWRT", "MAFID", "KLART"],
        "where":   "KLART = '023'",
        "primary": true
      }
    ],
    "package_size":          500,
    "max_rows_per_template": 25000
  },

  "transform": {
    "field_maps": {
      "OBJEK": "OBJECTKEYNEW"
    },
    "item_field_maps": {
      "ATINN": "CHARACT",
      "ATWRT": "VALUE_CHAR"
    },
    "dq_gates": [
      { "field": "OBJEK", "rule": "non_empty", "on_fail": "dead_letter", "code": "MISSING_OBJECT_KEY" },
      { "field": "ATINN", "rule": "non_empty", "on_fail": "dead_letter", "code": "MISSING_CHARACTERISTIC" },
      { "field": "KLART", "rule": "in_set", "rule_args": {"values": ["023"]}, "on_fail": "dead_letter", "code": "INVALID_CLASS_TYPE" }
    ]
  },

  "fk": {},

  "load": {
    "primary_lane": "BAPI",
    "fallback_lane": "MC",
    "bapi": {
      "function":         "BAPI_OBJCL_CREATE",
      "header_struct":    "OBJECTKEYNEW",
      "header_is_scalar": true,
      "item_struct":      "ALLOCVALUESCHAR",
      "extension_structure": "",
      "commit_with_wait": true,
      "return_key_field": "OBJECTKEYNEW"
    },
    "mc": {
      "object_id":        "BATCH_CLASSIFICATION",
      "staging_template": "S_BATCH_CLASSIFICATION"
    },
    "ltmom": {
      "source_object": "S_BATCH_CLASS_HEADER",
      "target_object": "CHARG"
    }
  },

  "verify": {
    "key_field":    "OBJEK",
    "value_fields": ["ATINN", "ATWRT"]
  },

  "extensions": {
    "supports_ZZ_fields":  false,
    "supports_partners":   false,
    "supports_conditions": false,
    "supports_longtexts":  false
  },

  "telemetry": {
    "category": "ClassificationReadiness",
    "affects":  ["BatchClassification"]
  },

  "version_routing": {
    "S4HANA_2020": { "use_bapi": "BAPI_OBJCL_CREATE" },
    "S4HANA_2022": { "use_bapi": "BAPI_OBJCL_CREATE" }
  }
}
