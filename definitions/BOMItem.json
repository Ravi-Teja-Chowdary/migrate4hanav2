{
  "object_type":      "BOMItem",
  "source_key_field": "MATNR",
  "home_table":       "STPO",
  "category":         "Master",
  "phase":            "explore",

  "extract": {
    "rfc": "RFC_READ_TABLE",
    "tables": [
      {
        "name":    "STPO",
        "fields":  ["MATNR", "IDNRK", "MENGE", "MEINS", "POSNR", "POSTP"],
        "where":   "LKENZ <> 'X'",
        "primary": true
      }
    ],
    "package_size":          500,
    "max_rows_per_template": 25000
  },

  "transform": {
    "field_maps": {},
    "item_field_maps": {
      "IDNRK":  "COMPONENT",
      "MENGE":  "COMP_QTY",
      "MEINS":  "COMP_UNIT"
    },
    "dq_gates": [
      { "field": "MATNR", "rule": "material_number_format", "on_fail": "dead_letter", "code": "INVALID_PARENT_MATERIAL" },
      { "field": "IDNRK", "rule": "material_number_format", "on_fail": "dead_letter", "code": "INVALID_COMPONENT" },
      { "field": "MENGE", "rule": "positive_number",        "on_fail": "dead_letter", "code": "INVALID_QUANTITY" },
      { "field": "MEINS", "rule": "sap_unit_of_measure",    "on_fail": "dead_letter", "code": "INVALID_UOM" }
    ]
  },

  "fk": {
    "MATNR": "Material",
    "IDNRK": "Material"
  },

  "load": {
    "primary_lane": "BAPI",
    "fallback_lane": "MC",
    "bapi": {
      "function":         "BAPI_MATERIAL_BOM_GROUP_CREATE",
      "header_struct":    "",
      "item_struct":      "ITEMS",
      "extension_structure": "",
      "commit_with_wait": true,
      "return_key_field": "RETURN"
    },
    "mc": {
      "object_id":        "BOM_ITEM",
      "staging_template": "S_BOM_ITEM"
    },
    "ltmom": {
      "source_object": "S_BOM_HEADER",
      "target_object": "MATNR"
    }
  },

  "verify": {
    "key_field":    "MATNR",
    "value_fields": ["IDNRK", "MENGE"]
  },

  "extensions": {
    "supports_ZZ_fields":  false,
    "supports_partners":   false,
    "supports_conditions": false,
    "supports_longtexts":  false
  },

  "telemetry": {
    "category": "ManufacturingReadiness",
    "affects":  ["BOMItem"]
  },

  "version_routing": {
    "S4HANA_2020": { "use_bapi": "BAPI_MATERIAL_BOM_GROUP_CREATE" },
    "S4HANA_2022": { "use_bapi": "BAPI_MATERIAL_BOM_GROUP_CREATE" }
  }
}
