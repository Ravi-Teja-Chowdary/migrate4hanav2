{
  "object_type":      "MasterRecipe",
  "source_key_field": "PLNNR",
  "home_table":       "PLKO",
  "category":         "Master",
  "phase":            "explore",

  "extract": {
    "rfc": "RFC_READ_TABLE",
    "tables": [
      {
        "name":    "PLKO",
        "fields":  ["PLNNR", "PLNTY", "PLNAL", "WERKS", "TEXT1"],
        "where":   "PLNTY = 'M' AND LOEKZ <> 'X'",
        "primary": true
      }
    ],
    "package_size":          500,
    "max_rows_per_template": 25000
  },

  "transform": {
    "field_maps": {
      "PLNTY": "PLAN_TYPE",
      "PLNAL": "GROUP_COUNTER",
      "WERKS": "PLANT",
      "TEXT1": "DESCRIPTION"
    },
    "item_field_maps": {},
    "dq_gates": [
      { "field": "PLNNR", "rule": "non_empty",   "on_fail": "dead_letter", "code": "MISSING_RECIPE_GROUP" },
      { "field": "WERKS", "rule": "werks_plant", "on_fail": "dead_letter", "code": "INVALID_PLANT" }
    ]
  },

  "fk": {},

  "load": {
    "primary_lane": "MC",
    "bapi": {
      "function":         "BAPI_MASTER_RECIPE_CREATE",
      "header_struct":    "RECIPE_HEADER",
      "extension_structure": "",
      "commit_with_wait": true,
      "return_key_field": "PLNNR"
    },
    "mc": {
      "object_id":        "MASTER_RECIPE",
      "staging_template": "S_MASTER_RECIPE"
    },
    "ltmom": {
      "source_object": "S_MASTER_RECIPE_HEADER",
      "target_object": "PLNNR"
    }
  },

  "verify": {
    "key_field":    "PLNNR",
    "value_fields": ["PLNTY", "WERKS"]
  },

  "extensions": { "supports_ZZ_fields": false, "supports_partners": false, "supports_conditions": false, "supports_longtexts": false },
  "telemetry": { "category": "ManufacturingReadiness", "affects": ["MasterRecipe"] },
  "version_routing": {
    "S4HANA_2020": { "use_bapi": "BAPI_MASTER_RECIPE_CREATE" },
    "S4HANA_2022": { "use_bapi": "BAPI_MASTER_RECIPE_CREATE" }
  }
}
