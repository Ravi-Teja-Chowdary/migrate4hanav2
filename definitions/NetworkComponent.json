{
  "object_type":      "NetworkComponent",
  "source_key_field": "AUFNR",
  "home_table":       "RESB",
  "category":         "Transactional",
  "phase":            "explore",

  "extract": {
    "rfc": "RFC_READ_TABLE",
    "tables": [
      {
        "name":    "RESB",
        "fields":  ["AUFNR", "POSNR", "MATNR", "WERKS", "BDMNG", "MEINS"],
        "where":   "XLOEK <> 'X'",
        "primary": true
      }
    ],
    "package_size":          500,
    "max_rows_per_template": 25000
  },

  "transform": {
    "field_maps": {
      "AUFNR": "NETWORK"
    },
    "item_field_maps": {
      "POSNR": "ITEM_NUMBER",
      "MATNR": "MATERIAL",
      "WERKS": "PLANT",
      "BDMNG": "ENTRY_QUANTITY",
      "MEINS": "BASE_UOM"
    },
    "dq_gates": [
      { "field": "AUFNR", "rule": "non_empty",              "on_fail": "dead_letter", "code": "MISSING_NETWORK" },
      { "field": "POSNR", "rule": "non_empty",              "on_fail": "dead_letter", "code": "MISSING_ITEM_NO" },
      { "field": "MATNR", "rule": "material_number_format", "on_fail": "dead_letter", "code": "INVALID_MATERIAL" },
      { "field": "WERKS", "rule": "werks_plant",            "on_fail": "dead_letter", "code": "INVALID_PLANT" },
      { "field": "BDMNG", "rule": "positive_number",        "on_fail": "dead_letter", "code": "INVALID_QUANTITY" },
      { "field": "MEINS", "rule": "sap_unit_of_measure",    "on_fail": "dead_letter", "code": "INVALID_UOM" }
    ]
  },

  "fk": {
    "MATNR": "Material",
    "WERKS": "Plant"
  },

  "load": {
    "primary_lane": "BAPI",
    "fallback_lane": "MC",
    "bapi": {
      "function":         "BAPI_NETWORK_COMP_ADD",
      "header_struct":    "NUMBER",
      "header_is_scalar": true,
      "item_struct":      "I_COMPONENTS_ADD",
      "extension_structure": "",
      "commit_with_wait": true,
      "return_key_field": "NETWORK"
    },
    "mc": {
      "object_id":        "NETWORK_COMPONENT",
      "staging_template": "S_NETWORK_COMPONENT"
    },
    "ltmom": {
      "source_object": "S_NETWORK_COMP_HEADER",
      "target_object": "AUFNR"
    }
  },

  "verify": {
    "key_field":    "AUFNR",
    "value_fields": ["POSNR", "MATNR"]
  },

  "extensions": {
    "supports_ZZ_fields":  false,
    "supports_partners":   false,
    "supports_conditions": false,
    "supports_longtexts":  false
  },

  "telemetry": {
    "category": "ProjectSystemReadiness",
    "affects":  ["NetworkComponent"]
  },

  "version_routing": {
    "S4HANA_2020": { "use_bapi": "BAPI_NETWORK_COMP_ADD" },
    "S4HANA_2022": { "use_bapi": "BAPI_NETWORK_COMP_ADD" }
  }
}
