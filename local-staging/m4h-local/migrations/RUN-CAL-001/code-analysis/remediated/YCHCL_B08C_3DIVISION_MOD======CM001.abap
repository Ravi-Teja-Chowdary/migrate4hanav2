METHOD EINGEBEN.
  IF xwert1 < 'SCRUBBED_STRING' OR xwert1 > 'SCRUBBED_STRING' OR xwert2 < 'SCRUBBED_STRING' OR xwert2 > 'SCRUBBED_STRING'.
    RAISE EXCEPTION TYPE zusatzausnahme.
  ENDIF.
  CALL METHOD super.
  CASE sy-subrc.
    WHEN 1.
      RAISE EXCEPTION TYPE wert_ist_null.
  ENDCASE.
  yfunktion = 'SCRUBBED_STRING'.
ENDMETHOD.