REPORT YAK_OO_A_CLASS_FINAL.
TABLES SFLIGHT.
CLASS CL_FLIGHT DEFINITION.
  PUBLIC SECTION.
  METHODS : SET_DATA IMPORTING IM_CARRID LIKE SFLIGHT-CARRID IM_CONNID LIKE SFLIGHT-CONNID IM_FLDATE LIKE SFLIGHT-FLDATE , GET_DATA EXPORTING EX_CARRID LIKE SFLIGHT-CARRID EX_CONNID LIKE SFLIGHT-CONNID EX_FLDATE LIKE SFLIGHT-FLDATE , WRITE_DATA.
  PRIVATE SECTION.
  DATA CARRID LIKE SFLIGHT-CARRID.
  DATA CONNID LIKE SFLIGHT-CONNID.
  DATA FLDATE LIKE SFLIGHT-FLDATE.
ENDCLASS.
CLASS CL_FLIGHT IMPLEMENTATION.
  METHOD SET_DATA.
    CARRID = IM_CARRID.
    CONNID = IM_CONNID.
    FLDATE = IM_FLDATE.
  ENDMETHOD.
  METHOD GET_DATA.
    EX_CARRID = CARRID.
    EX_CONNID = CONNID.
    EX_FLDATE = FLDATE.
  ENDMETHOD.
  METHOD WRITE_DATA.
    WRITE /.
    'SCRUBBED_STRING' ( 001 ) , 25 CARRID , / 'SCRUBBED_STRING' ( 002 ) , 25 CONNID , / 'SCRUBBED_STRING' ( 003 ) , 25 FLDATE , /.
  ENDMETHOD.
ENDCLASS.
DATA F1 TYPE REF TO CL_FLIGHT.
DATA F2 TYPE REF TO CL_FLIGHT.
START-OF-SELECTION.
CREATE OBJECT F1.
CREATE OBJECT F2.
CALL METHOD F2.
GET PARAMETER ID SFLIGHT FIELD .
CALL METHOD F1.
STOP.
END-OF-SELECTION.
CALL METHOD F1.
CALL METHOD F2.
F2 = F1.
CALL METHOD F2.