REPORT SAPBC405DAPD_E_EXTR_FIELD_SYMB.
NODES : SPFLI , SFLIGHT.
DATA POS1 TYPE I VALUE 14.
DATA POS2 TYPE I VALUE 27.
DATA POS3 TYPE I VALUE 37.
DATA POS4 TYPE I VALUE 58.
DATA POS5 TYPE I VALUE 57.
DATA LEN1 TYPE I VALUE 62.
DATA LEN2 TYPE I.
DATA LEN3 TYPE I.
DATA LEN4 TYPE I.
DATA SEATSFREE TYPE P.
DATA SORT1.
( 7 ) VALUE 'SCRUBBED_STRING'.
FIELD-SYMBOLS <F1>.
FIELD-SYMBOLS <F2>.
SELECTION-SCREEN BEGIN OF BLOCK DATE WITH FRAME TITLE TEXT - 001.
PARAMETERS :.
TIME RADIOBUTTON GROUP SORT , CARRIER RADIOBUTTON GROUP SORT.
SELECTION-SCREEN END OF BLOCK DATE.
FIELD-GROUPS :.
HEADER , CONNECTIONS , FLIGHTS.
START-OF-SELECTION.
IF TIME EQ 'SCRUBBED_STRING'.
  ASSIGN SPFLI-DEPTIME TO <F1>.
  ASSIGN SPFLI-CARRID TO <F2>.
ELSE.
  ASSIGN SPFLI-DEPTIME TO <F2>.
  ASSIGN SPFLI-CARRID TO <F1>.
  SORT1 = 'SCRUBBED_STRING'.
ENDIF.
INSERT : INTO TABLE SPFLI-CITYFROM.
SPFLI-CITYTO <F1> <F2> SFLIGHT-FLDATE INTO HEADER , SPFLI-CONNID INTO CONNECTIONS , SFLIGHT-PRICE SFLIGHT-CURRENCY SEATSFREE INTO FLIGHTS.
GET PARAMETER ID SPFLI FIELD FIELDS.
CITYFROM CARRID CONNID CITYTO DEPTIME ARRTIME.
EXTRACT CONNECTIONS.
GET PARAMETER ID SFLIGHT FIELD FIELDS.
FLDATE PRICE CURRENCY SEATSMAX SEATSOCC.
SEATSFREE = SFLIGHT-SEATSMAX - SFLIGHT-SEATSOCC.
EXTRACT FLIGHTS.
END-OF-SELECTION.
SORT ..
LOOP .
AT NEW SPFLI-CITYFROM.
FORMAT COLOR COL_GROUP INTENSIFIED ON.
WRITE AT : / ( LEN1 ) SPFLI-CITYFROM.
ENDAT.
AT NEW SPFLI-CITYTO.
FORMAT COLOR COL_GROUP INTENSIFIED OFF.
WRITE AT : /POS1 ( LEN2 ) SPFLI-CITYTO.
ENDAT.
AT NEW <F1>.
FORMAT COLOR COL_KEY INTENSIFIED OFF.
WRITE AT : /POS2 ( LEN3 ) <F1>.
ENDAT.
AT CONNECTIONS.
FORMAT COLOR COL_NORMAL INTENSIFIED OFF.
IF SORT1 = 'SCRUBBED_STRING'.
  WRITE AT : /POS2 <F2> , POS3 ( LEN4 ) SPFLI-CONNID.
ELSE.
  WRITE AT : /POS2 SPFLI-CONNID , POS3 ( LEN4 ) <F2>.
ENDIF.
ENDAT.
AT FLIGHTS.
FORMAT COLOR COL_NORMAL INTENSIFIED OFF.
WRITE AT.
/POS2 SFLIGHT-FLDATE , AT ( 12 ) SFLIGHT-PRICE CURRENCY SFLIGHT-CURRENCY , SFLIGHT-CURRENCY , AT POS4 ( 5 ) SEATSFREE.
ENDAT.
AT END OF <F1>.
SKIP.
ENDAT.
ENDLOOP.
INITIALIZATION.
LEN2 = LEN1 - POS1 + 1.
LEN3 = LEN1 - POS2 + 1.
LEN4 = LEN1 - POS3 + 1.
TOP-OF-PAGE.
FORMAT COLOR COL_HEADING INTENSIFIED OFF.
WRITE 'SCRUBBED_STRING'.
( 002 ) , AT POS1 'SCRUBBED_STRING' ( 003 ).
IF SORT1 = 'SCRUBBED_STRING'.
  WRITE AT : POS2 ( LEN3 ) 'SCRUBBED_STRING' ( 004 ) , /POS2 'SCRUBBED_STRING' ( 005 ) , POS3 ( LEN4 ) 'SCRUBBED_STRING' ( 006 ).
ELSE.
  WRITE AT : POS2 ( LEN3 ) 'SCRUBBED_STRING' ( 005 ) , /POS2 'SCRUBBED_STRING' ( 004 ) , POS3 ( LEN4 ) 'SCRUBBED_STRING' ( 006 ).
ENDIF.
WRITE AT.
/POS2 'SCRUBBED_STRING' ( 007 ) , 'SCRUBBED_STRING' ( 008 ) , AT POS5 ( 6 ) 'SCRUBBED_STRING' ( 009 ) , AT /POS5 'SCRUBBED_STRING' ( 010 ).