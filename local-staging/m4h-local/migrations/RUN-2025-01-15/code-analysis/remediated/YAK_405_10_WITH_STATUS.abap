REPORT YAK_405_10_WITH_STATUS LINE-SIZE 80.
NODES : SPFLI , SFLIGHT.
TABLES SCARR.
CONSTANTS BLANK VALUE 'SCRUBBED_STRING'.
CONSTANTS POS1 TYPE I VALUE 14.
CONSTANTS POS2 TYPE I VALUE 32.
CONSTANTS POS3 TYPE I VALUE 36.
DATA FREE_SEATS LIKE SFLIGHT-SEATSMAX.
DATA CARRIER LIKE SPFLI-CARRID.
DATA MENU_ENTRY.
( 40 ).
GET PARAMETER ID SPFLI FIELD FIELDS.
CARRID CONNID CITYFROM CITYTO DEPTIME ARRTIME.
FORMAT COLOR COL_NORMAL INTENSIFIED OFF.
WRITE /.
SPFLI-CARRID COLOR COL_KEY , 6 SPFLI-CONNID COLOR COL_KEY , 15 SPFLI-CITYFROM , SPFLI-CITYTO , SPFLI-DEPTIME , 70 SPFLI-ARRTIME , AT SY-LINSZ BLANK.
HIDE : SPFLI-CARRID , SPFLI-CONNID.
END-OF-SELECTION.
MENU_ENTRY = 'SCRUBBED_STRING''SCRUBBED_STRING' ( 004 ).
SET PF-STATUS 'SCRUBBED_STRING'.
SET TITLEBAR 'SCRUBBED_STRING'.
CLEAR SPFLI-CARRID.
AT USER-COMMAND.
CASE SY-UCOMM.
  WHEN 'SCRUBBED_STRING'.
    CHECK NOT SPFLI-CARRID IS INITIAL.
    FORMAT COLOR COL_NORMAL INTENSIFIED OFF.
    NEW-PAGE LINE-SIZE 55.
    CARRIER = SPFLI-CARRID.
    SET PF-STATUS 'SCRUBBED_STRING'.
    SET TITLEBAR 'SCRUBBED_STRING' WITH SPFLI-CARRID.
    SELECT FLDATE PRICE CURRENCY SEATSMAX SEATSOCC
      FROM SFLIGHT
      INTO CORRESPONDING FIELDS OF SFLIGHT
      WHERE CARRID = SPFLI-CARRID AND CONNID = SPFLI-CONNID
    .
      FREE_SEATS = SFLIGHT-SEATSMAX - SFLIGHT-SEATSOCC.
      WRITE /.
      SFLIGHT-FLDATE COLOR COL_KEY , AT POS1 ( 11 ) SFLIGHT-PRICE CURRENCY SFLIGHT-CURRENCY , SFLIGHT-CURRENCY , AT POS2 ( 8 ) FREE_SEATS , AT SY-LINSZ BLANK.
    ENDSELECT.
    CONCATENATE 'SCRUBBED_STRING''SCRUBBED_STRING' ( 004 ) SPFLI-CARRID INTO MENU_ENTRY SEPARATED BY BLANK.
    CLEAR SPFLI-CARRID.
  WHEN 'SCRUBBED_STRING'.
    FORMAT COLOR COL_NORMAL INTENSIFIED OFF.
    NEW-PAGE LINE-SIZE 60.
    SET PF-STATUS 'SCRUBBED_STRING'.
    SET TITLEBAR 'SCRUBBED_STRING' WITH CARRIER.
    SELECT SINGLE CARRNAME CURRCODE
      FROM SCARR
      INTO CORRESPONDING FIELDS OF SCARR
      WHERE CARRID = CARRIER
    .
    WRITE 'SCRUBBED_STRING'.
    ( 006 ) , 'SCRUBBED_STRING' ( 005 ) , AT POS3 CARRIER , AT SY-LINSZ BLANK , / 'SCRUBBED_STRING' ( 007 ) , 'SCRUBBED_STRING' ( 005 ) , AT POS3 SCARR-CARRNAME , AT SY-LINSZ BLANK , / 'SCRUBBED_STRING' ( 008 ) , 'SCRUBBED_STRING' ( 005 ) , AT POS3 SCARR-CURRCODE , AT SY-LINSZ BLANK.
  WHEN 'SCRUBBED_STRING'.
    SY-LSIND = SY-LSIND - 3.
    MENU_ENTRY = 'SCRUBBED_STRING''SCRUBBED_STRING' ( 004 ).
ENDCASE.
TOP-OF-PAGE.
DURING LINE-SELECTION.
CASE SY-PFKEY.
  WHEN 'SCRUBBED_STRING'.
    FORMAT COLOR COL_TOTAL.
    WRITE SPFLI-CARRID SPFLI-CONNID.
    FORMAT COLOR COL_HEADING.
    WRITE /.
    'SCRUBBED_STRING' ( 001 ) , AT POS1 'SCRUBBED_STRING' ( 002 ) , AT POS2 'SCRUBBED_STRING' ( 003 ) , AT SY-LINSZ BLANK.
    ULINE AT ( SY-LINSZ ).
ENDCASE.