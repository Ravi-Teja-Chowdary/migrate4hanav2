REPORT YBC405_10_GUI_WITH_STATUS LINE-SIZE 90.
TYPES: BEGIN OF FL_SPFLI_TYPE,
TYPES CARRID.
LIKE SPFLI-CARRID , CONNID LIKE SPFLI-CONNID , CITYFROM LIKE SPFLI-CITYFROM , CITYTO LIKE SPFLI-CITYTO , FLTIME LIKE SPFLI-FLTIME , DEPTIME LIKE SPFLI-DEPTIME , ARRTIME LIKE SPFLI-ARRTIME , END OF FL_SPFLI_TYPE , BEGIN OF FL_SFLIGHT_TYPE , FLDATE LIKE SFLIGHT-FLDATE , PRICE LIKE SFLIGHT-PRICE , CURRENCY LIKE SFLIGHT-CURRENCY , PLANETYPE LIKE SFLIGHT-PLANETYPE , SEATSMAX LIKE SFLIGHT-SEATSMAX , SEATSOCC LIKE SFLIGHT-SEATSOCC , END OF FL_SFLIGHT_TYPE , BEGIN OF FL_SBOOK_TYPE , BOOKID LIKE SBOOK-BOOKID , CUSTOMID LIKE SBOOK-CUSTOMID , FORM LIKE SCUSTOM-FORM , NAME LIKE SCUSTOM-NAME , STREET LIKE SCUSTOM-STREET , POSTCODE LIKE SCUSTOM-POSTCODE , CITY LIKE SCUSTOM-CITY , END OF FL_SBOOK_TYPE.
DATA POS1 TYPE I VALUE 10.
DATA POS2 TYPE I VALUE 20.
DATA POS3 TYPE I VALUE 30.
DATA POS4 TYPE I VALUE 40.
DATA POS5 TYPE I VALUE 50.
DATA POS7 TYPE I VALUE 70.
DATA POS9 TYPE I VALUE 89.
DATA FL_SPFLI TYPE FL_SPFLI_TYPE.
DATA FL_SFLIGHT TYPE FL_SFLIGHT_TYPE.
DATA FL_SBOOK TYPE FL_SBOOK_TYPE.
DATA ITAB_SPFLI TYPE STANDARD TABLE OF FL_SPFLI_TYPE.
DATA ITAB_SFLIGHT TYPE STANDARD TABLE OF FL_SFLIGHT_TYPE.
DATA ITAB_SBOOK TYPE STANDARD TABLE OF FL_SBOOK_TYPE.
START-OF-SELECTION.
SET PF-STATUS 'SCRUBBED_STRING'.
SET TITLEBAR 'SCRUBBED_STRING'.
SELECT CARRID CONNID CITYFROM CITYTO
  FROM SPFLI
  INTO CORRESPONDING FIELDS OF FL_SPFLI
.
  WRITE /.
  FL_SPFLI-CARRID , FL_SPFLI-CONNID , FL_SPFLI-CITYFROM , AT POS4 FL_SPFLI-CITYTO.
  HIDE : FL_SPFLI-CARRID , FL_SPFLI-CONNID , FL_SPFLI-CITYFROM , FL_SPFLI-CITYTO.
ENDSELECT.
CLEAR FL_SPFLI.
AT USER-COMMAND.
CASE SY-LSIND.
  WHEN 1.
    CHECK NOT FL_SPFLI IS INITIAL.
    CASE SY-UCOMM.
      WHEN 'SCRUBBED_STRING'.
        SET PF-STATUS 'SCRUBBED_STRING'.
        SET TITLEBAR 'SCRUBBED_STRING' WITH FL_SPFLI-CARRID FL_SPFLI-CONNID.
        FORMAT COLOR COL_KEY INTENSIFIED OFF.
        WRITE /.
        FL_SPFLI-CARRID , FL_SPFLI-CONNID , FL_SPFLI-CITYFROM , AT POS4 FL_SPFLI-CITYTO.
        FORMAT COLOR COL_NORMAL.
        SELECT SINGLE *
          FROM SPFLI
          INTO CORRESPONDING FIELDS OF FL_SPFLI
          WHERE CARRID = FL_SPFLI-CARRID AND CONNID = FL_SPFLI-CONNID
        .
        WRITE /.
        FL_SPFLI-DEPTIME , AT POS1 FL_SPFLI-ARRTIME , AT POS2 FL_SPFLI-FLTIME.
      WHEN 'SCRUBBED_STRING'.
        SET PF-STATUS 'SCRUBBED_STRING'.
        SET TITLEBAR 'SCRUBBED_STRING' WITH FL_SPFLI-CARRID FL_SPFLI-CONNID.
        FORMAT COLOR COL_KEY INTENSIFIED OFF.
        WRITE /.
        FL_SPFLI-CARRID , FL_SPFLI-CONNID , FL_SPFLI-CITYFROM , AT POS4 FL_SPFLI-CITYTO.
        FORMAT COLOR COL_NORMAL.
        SELECT FLDATE
          FROM SFLIGHT
          INTO CORRESPONDING FIELDS OF FL_SFLIGHT
          WHERE CARRID = FL_SPFLI-CARRID AND CONNID = FL_SPFLI-CONNID
        .
          WRITE /.
          FL_SFLIGHT-FLDATE.
          HIDE : FL_SPFLI-CARRID , FL_SPFLI-CONNID , FL_SPFLI-CITYFROM , FL_SPFLI-CITYTO , FL_SFLIGHT-FLDATE.
        ENDSELECT.
    ENDCASE.
    CLEAR: FL_SPFLI, FL_SFLIGHT.
  WHEN 2.
    CHECK NOT FL_SFLIGHT IS INITIAL.
    CASE SY-UCOMM.
      WHEN 'SCRUBBED_STRING'.
        SET PF-STATUS 'SCRUBBED_STRING'.
        SET TITLEBAR 'SCRUBBED_STRING' WITH FL_SPFLI-CARRID FL_SPFLI-CONNID FL_SFLIGHT-FLDATE.
        FORMAT COLOR COL_KEY INTENSIFIED OFF.
        WRITE /.
        FL_SPFLI-CARRID , FL_SPFLI-CONNID , FL_SPFLI-CITYFROM , AT POS4 FL_SPFLI-CITYTO.
        FORMAT COLOR COL_NORMAL.
        WRITE /.
        FL_SFLIGHT-FLDATE.
        FORMAT INTENSIFIED OFF.
        SELECT SINGLE *
          FROM SFLIGHT
          INTO CORRESPONDING FIELDS OF FL_SFLIGHT
          WHERE CARRID = FL_SPFLI-CARRID AND CONNID = FL_SPFLI-CONNID AND FLDATE = FL_SFLIGHT-FLDATE
        .
        WRITE AT.
        / ( POS1 ) FL_SFLIGHT-PRICE CURRENCY FL_SFLIGHT-CURRENCY , FL_SFLIGHT-CURRENCY , AT POS2 FL_SFLIGHT-SEATSMAX LEFT-JUSTIFIED , AT POS3 FL_SFLIGHT-SEATSOCC LEFT-JUSTIFIED , AT POS4 FL_SFLIGHT-PLANETYPE.
      WHEN 'SCRUBBED_STRING'.
        SET PF-STATUS 'SCRUBBED_STRING'.
        SET TITLEBAR 'SCRUBBED_STRING' WITH FL_SPFLI-CARRID FL_SPFLI-CONNID FL_SFLIGHT-FLDATE.
        FORMAT COLOR COL_KEY INTENSIFIED OFF.
        WRITE /.
        FL_SPFLI-CARRID , FL_SPFLI-CONNID , FL_SPFLI-CITYFROM , AT POS4 FL_SPFLI-CITYTO.
        FORMAT COLOR COL_NORMAL.
        WRITE /.
        FL_SFLIGHT-FLDATE.
        FORMAT INTENSIFIED OFF.
        SELECT BOOKID CUSTOMID
          FROM SBOOK
          INTO CORRESPONDING FIELDS OF FL_SBOOK
          WHERE CARRID = FL_SPFLI-CARRID AND CONNID = FL_SPFLI-CONNID AND FLDATE = FL_SFLIGHT-FLDATE
        .
          WRITE /.
          FL_SBOOK-BOOKID , AT POS2 FL_SBOOK-CUSTOMID.
          HIDE : FL_SPFLI-CARRID , FL_SPFLI-CONNID , FL_SPFLI-CITYFROM , FL_SPFLI-CITYTO , FL_SFLIGHT-FLDATE , FL_SBOOK-BOOKID , FL_SBOOK-CUSTOMID.
        ENDSELECT.
    ENDCASE.
    CLEAR: FL_SPFLI, FL_SFLIGHT, FL_SBOOK.
  WHEN 3.
    CHECK NOT FL_SBOOK IS INITIAL.
    CASE SY-UCOMM.
      WHEN 'SCRUBBED_STRING'.
        SET PF-STATUS 'SCRUBBED_STRING'.
        SET TITLEBAR 'SCRUBBED_STRING' WITH FL_SPFLI-CARRID FL_SPFLI-CONNID FL_SFLIGHT-FLDATE FL_SBOOK-BOOKID FL_SBOOK-CUSTOMID.
        FORMAT COLOR COL_KEY INTENSIFIED OFF.
        WRITE /.
        FL_SPFLI-CARRID , FL_SPFLI-CONNID , FL_SPFLI-CITYFROM , AT POS4 FL_SPFLI-CITYTO.
        FORMAT COLOR COL_NORMAL.
        WRITE /.
        FL_SFLIGHT-FLDATE.
        FORMAT INTENSIFIED OFF.
        WRITE /.
        FL_SBOOK-BOOKID , AT POS2 FL_SBOOK-CUSTOMID.
        FORMAT COLOR COL_BACKGROUND.
        SELECT SINGLE *
          FROM SCUSTOM
          INTO CORRESPONDING FIELDS OF FL_SBOOK
          WHERE ID = FL_SBOOK-CUSTOMID
        .
        WRITE /.
        FL_SBOOK-FORM , AT POS1 FL_SBOOK-NAME , AT POS3 FL_SBOOK-STREET , AT POS5 FL_SBOOK-POSTCODE , AT POS7 FL_SBOOK-CITY.
    ENDCASE.
    CLEAR: FL_SPFLI, FL_SFLIGHT, FL_SBOOK.
ENDCASE.
TOP-OF-PAGE.
DURING LINE-SELECTION.
CASE SY-LSIND.
  WHEN 1.
    CASE SY-UCOMM.
      WHEN 'SCRUBBED_STRING'.
        FORMAT COLOR COL_HEADING.
        WRITE /.
        'SCRUBBED_STRING' , 'SCRUBBED_STRING' , 'SCRUBBED_STRING' , AT POS4 ( POS5 ) 'SCRUBBED_STRING'.
        WRITE /.
        'SCRUBBED_STRING' , AT POS1 'SCRUBBED_STRING' , AT POS2 ( POS7 ) 'SCRUBBED_STRING'.
      WHEN 'SCRUBBED_STRING'.
        FORMAT COLOR COL_HEADING.
        WRITE /.
        'SCRUBBED_STRING' , 'SCRUBBED_STRING' , 'SCRUBBED_STRING' , AT POS4 ( POS5 ) 'SCRUBBED_STRING'.
        WRITE AT.
        / ( POS9 ) 'SCRUBBED_STRING'.
    ENDCASE.
  WHEN 2.
    CASE SY-UCOMM.
      WHEN 'SCRUBBED_STRING'.
        FORMAT COLOR COL_HEADING.
        WRITE /.
        'SCRUBBED_STRING' , 'SCRUBBED_STRING' , 'SCRUBBED_STRING' , AT POS4 ( POS5 ) 'SCRUBBED_STRING'.
        WRITE AT.
        / ( POS9 ) 'SCRUBBED_STRING'.
        WRITE /.
        'SCRUBBED_STRING' , AT POS2 'SCRUBBED_STRING' , AT POS3 'SCRUBBED_STRING' , AT POS4 ( POS5 ) 'SCRUBBED_STRING'.
      WHEN 'SCRUBBED_STRING'.
        FORMAT COLOR COL_HEADING.
        WRITE /.
        'SCRUBBED_STRING' , 'SCRUBBED_STRING' , 'SCRUBBED_STRING' , AT POS4 ( POS5 ) 'SCRUBBED_STRING'.
        WRITE AT.
        / ( POS9 ) 'SCRUBBED_STRING'.
        WRITE /.
        'SCRUBBED_STRING' , AT POS2 ( POS7 ) 'SCRUBBED_STRING'.
    ENDCASE.
  WHEN 3.
    CASE SY-UCOMM.
      WHEN 'SCRUBBED_STRING'.
        FORMAT COLOR COL_HEADING.
        WRITE /.
        'SCRUBBED_STRING' , 'SCRUBBED_STRING' , 'SCRUBBED_STRING' , AT POS4 ( POS5 ) 'SCRUBBED_STRING'.
        WRITE AT.
        / ( POS9 ) 'SCRUBBED_STRING'.
        WRITE /.
        'SCRUBBED_STRING' , AT POS2 ( POS7 ) 'SCRUBBED_STRING'.
        WRITE /.
        'SCRUBBED_STRING' , AT POS1 'SCRUBBED_STRING' , AT POS3 'SCRUBBED_STRING' , AT POS5 'SCRUBBED_STRING' , AT POS7 ( POS2 ) 'SCRUBBED_STRING'.
    ENDCASE.
ENDCASE.
ULINE.