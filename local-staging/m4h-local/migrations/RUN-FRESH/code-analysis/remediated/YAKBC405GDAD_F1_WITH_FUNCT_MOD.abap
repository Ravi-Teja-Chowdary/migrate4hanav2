MODULE STATUS_0100 OUTPUT.
SET PF-STATUS 'SCRUBBED_STRING'.
SET TITLEBAR 'SCRUBBED_STRING'.
ENDMODULE.
MODULE BACK INPUT.
SET SCREEN 0.
ENDMODULE.