CALL FUNCTION 'SCRUBBED_STRING'
  EXPORTING
    LANGUAGE = SY-LANGU
    POPUP_TITLE = TEXT
    - = 
    001 = 
    START_COLUMN = 10
    START_ROW = 3
    TEXT_OBJECT = 'SCRUBBED_STRING'
  EXCEPTIONS
    TEXT_NOT_FOUND = 1
.
IF SY-SUBRC = 1.
  WRITE 'SCRUBBED_STRING' ( 002 ).
ENDIF.
GET PARAMETER ID SPFLI FIELD .
WRITE SPFLI-CARRID.
