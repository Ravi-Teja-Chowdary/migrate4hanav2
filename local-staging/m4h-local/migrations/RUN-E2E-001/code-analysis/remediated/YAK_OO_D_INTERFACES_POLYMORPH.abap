*&---------------------------------------------------------------------*
*& Report  YAK_OO_C_INTERFACES_POLYMORPH                               *
*&                                                                     *
*&---------------------------------------------------------------------*
REPORT YAK_OO_C_INTERFACES_POLYMORPH.
TABLES SFLIGHT.
* Interface definition
INTERFACE IF_WRITE.
  METHODS : WRITE_DATA.
ENDINTERFACE.
INCLUDE YAK_OO_C_INTERFACES_INCLUDE.
* Class definition
CLASS CL_FLIGHT DEFINITION.
  * Public section
  PUBLIC SECTION.
  INTERFACES : IF_WRITE.
  METHODS : SET_DATA IMPORTING IM_CARRID LIKE SFLIGHT-CARRID IM_CONNID LIKE SFLIGHT-CONNID IM_FLDATE LIKE SFLIGHT-FLDATE.
  * Private section.
  PRIVATE SECTION.
  DATA CARRID LIKE SFLIGHT-CARRID.
  DATA CONNID LIKE SFLIGHT-CONNID.
  DATA FLDATE LIKE SFLIGHT-FLDATE.
ENDCLASS.
* Class implementation
CLASS CL_FLIGHT IMPLEMENTATION.
  METHOD SET_DATA.
    CARRID = IM_CARRID.
    CONNID = IM_CONNID.
    FLDATE = IM_FLDATE.
  ENDMETHOD.
  METHOD IF_WRITE~WRITE_DATA.
    WRITE /.
    'Fluggesellschaft:' ( 001 ) , 25 CARRID , / 'Flugverbindungsnummer:' ( 002 ) , 25 CONNID , / 'Flugdatum' ( 003 ) , 25 FLDATE , /.
  ENDMETHOD.
ENDCLASS.
DATA F1 TYPE REF TO CL_FLIGHT.
DATA B1 TYPE REF TO CL_BOOK.
DATA I1 TYPE REF TO IF_WRITE.
* START-OF-SELECTION
START-OF-SELECTION.
CREATE OBJECT F1.
CREATE OBJECT B1.
* GET sflight
GET PARAMETER ID SFLIGHT FIELD .
CALL METHOD F1.
* GET sbook
GET PARAMETER ID SBOOK FIELD .
CALL METHOD B1.
STOP.
* END-OF-SELECTION
END-OF-SELECTION.
I1 = F1.
CALL METHOD I1.
I1 = B1.
CALL METHOD I1.