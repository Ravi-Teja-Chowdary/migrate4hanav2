  CLASS-METHODS : CM_INCREASE_N_O_OBJECTS.
ENDCLASS.
* Class implementation
CLASS CL_FLIGHT IMPLEMENTATION.
  METHOD SET_DATA.
    CARRID = IM_CARRID.
    CONNID = IM_CONNID.
    FLDATE = IM_FLDATE.
    *  Call of class method
    CALL METHOD CM_INCREASE_N_O_OBJECTS.
  ENDMETHOD.
  METHOD GET_DATA.
    EX_CARRID = CARRID.
    EX_CONNID = CONNID.
    EX_FLDATE = FLDATE.
  ENDMETHOD.
  METHOD WRITE_DATA.
    WRITE /.
    'Fluggesellschaft:' ( 001 ) , 25 CARRID , / 'Flugverbindungsnummer:' ( 002 ) , 25 CONNID , / 'Flugdatum' ( 003 ) , 25 FLDATE , /.
  ENDMETHOD.
  METHOD CM_SHOW_N_O_OBJECTS.
    WRITE /.
    'aktuelle Anzahl von Flugobjekten: ' ( 004 ) , CD_N_O_OBJECTS , /.
  ENDMETHOD.
  METHOD CM_INCREASE_N_O_OBJECTS.
    CD_N_O_OBJECTS = CD_N_O_OBJECTS + 1.
  ENDMETHOD.
ENDCLASS.
