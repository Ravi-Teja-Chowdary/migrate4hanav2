variable "resource_group_name" {
  description = "Name of the resource group"
  type        = string
}

variable "location" {
  description = "Azure region for resources"
  type        = string
}

variable "environment" {
  description = "Environment name (dev, staging, prod)"
  type        = string
}

variable "backend_host" {
  description = "Backend hostname for the origin (APIM or Function App FQDN)"
  type        = string
}

variable "enable_waf" {
  description = "Whether to enable WAF resources"
  type        = bool
  default     = true
}

variable "tags" {
  description = "Tags to apply to resources"
  type        = map(string)
  default     = {}
}
