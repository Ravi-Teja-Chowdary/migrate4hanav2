{
  "Comment": "Migrate4HANA - 17-Stage SAP Activate Pipeline (5 Phases)",
  "StartAt": "PreFlightChecks",
  "States": {
    "PreFlightChecks": {
      "Type": "Task",
      "Resource": "${DiscoveryEngineArn}",
      "Next": "Phase1_Prepare_Marker",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "RollbackManager"
        }
      ]
    },

    "Phase1_Prepare_Marker": {
      "Type": "Pass",
      "Comment": "Phase 1: PREPARE - Assessment & Pre-Checks",
      "Result": {
        "phase": 1,
        "phase_name": "PREPARE",
        "description": "Assessment & Pre-Checks"
      },
      "ResultPath": "$.phase_telemetry",
      "Next": "Stage1_Discovery"
    },

    "Stage1_Discovery": {
      "Type": "Task",
      "Resource": "${DiscoveryEngineArn}",
      "Next": "Stage2_MaintenancePlanner",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "RollbackManager"
        }
      ]
    },
    "Stage2_MaintenancePlanner": {
      "Type": "Task",
      "Resource": "${MaintenancePlannerArn}",
      "Next": "Stage3_ReadinessCheck",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "RollbackManager"
        }
      ]
    },
    "Stage3_ReadinessCheck": {
      "Type": "Task",
      "Resource": "${ReadinessCheckArn}",
      "Next": "Stage4_SimplificationCheck",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "RollbackManager"
        }
      ]
    },
    "Stage4_SimplificationCheck": {
      "Type": "Task",
      "Resource": "${SimplificationCheckArn}",
      "Next": "Phase2_Explore_Marker",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "RollbackManager"
        }
      ]
    },

    "Phase2_Explore_Marker": {
      "Type": "Pass",
      "Comment": "Phase 2: EXPLORE - Application Preparation",
      "Result": {
        "phase": 2,
        "phase_name": "EXPLORE",
        "description": "Application Preparation"
      },
      "ResultPath": "$.phase_telemetry",
      "Next": "Stage5_CodeAnalysis"
    },

    "Stage5_CodeAnalysis": {
      "Type": "Task",
      "Resource": "${CodeAnalyzerArn}",
      "Next": "InvokeBedrockLLM",
      "ResultPath": "$.CodeRemediationContext",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "RollbackManager"
        }
      ]
    },
    "InvokeBedrockLLM": {
      "Type": "Task",
      "Resource": "${BedrockLLMConnectorArn}",
      "Next": "Stage6_DataHygiene",
      "ResultPath": "$.RemediatedCode",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "RollbackManager"
        }
      ]
    },
    "Stage6_DataHygiene": {
      "Type": "Task",
      "Resource": "${DataHygieneArn}",
      "Next": "Stage7_DataAssessment",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "RollbackManager"
        }
      ]
    },
    "Stage7_DataAssessment": {
      "Type": "Task",
      "Resource": "${DataMigratorArn}",
      "Next": "Stage8_ConfigAssessment",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "RollbackManager"
        }
      ]
    },
    "Stage8_ConfigAssessment": {
      "Type": "Task",
      "Resource": "${ConfigReplicatorArn}",
      "Next": "ConversionApprovalGate",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "RollbackManager"
        }
      ]
    },

    "ConversionApprovalGate": {
      "Type": "Choice",
      "Comment": "Critical gate: verify all Phase 1-2 stages passed before allowing Phase 3",
      "Choices": [
        {
          "And": [
            {
              "Variable": "$.phase_telemetry.phase",
              "NumericGreaterThanEquals": 2
            },
            {
              "Variable": "$.CodeRemediationContext.status",
              "StringEquals": "success"
            }
          ],
          "Next": "Phase3_Realize_Marker"
        }
      ],
      "Default": "ConversionGateBlocked"
    },

    "ConversionGateBlocked": {
      "Type": "Fail",
      "Error": "ConversionGateBlocked",
      "Cause": "Phase 1-2 stages did not pass. Conversion cannot proceed."
    },

    "Phase3_Realize_Marker": {
      "Type": "Pass",
      "Comment": "Phase 3: REALIZE - Technical System Conversion (SUM/DMO)",
      "Result": {
        "phase": 3,
        "phase_name": "REALIZE",
        "description": "Technical System Conversion"
      },
      "ResultPath": "$.phase_telemetry",
      "Next": "Stage9_PreConversionGate"
    },

    "Stage9_PreConversionGate": {
      "Type": "Task",
      "Resource": "${CutoverOrchestratorArn}",
      "Next": "Stage10_SUM_DMO",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "RollbackManager"
        }
      ]
    },
    "Stage10_SUM_DMO": {
      "Type": "Task",
      "Resource": "${SUMOrchestratorArn}",
      "Next": "Phase4_PostConversion_Marker",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "RollbackManager"
        }
      ]
    },

    "Phase4_PostConversion_Marker": {
      "Type": "Pass",
      "Comment": "Phase 4: POST-CONVERSION - Deploy & Validate",
      "Result": {
        "phase": 4,
        "phase_name": "POST_CONVERSION",
        "description": "Post-Conversion Deploy & Validate"
      },
      "ResultPath": "$.phase_telemetry",
      "Next": "Stage11_CodeDeploy"
    },

    "Stage11_CodeDeploy": {
      "Type": "Task",
      "Resource": "${CodeDeployerArn}",
      "Next": "Stage12_DataLoad",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "RollbackManager"
        }
      ]
    },
    "Stage12_DataLoad": {
      "Type": "Task",
      "Resource": "${DataLoaderArn}",
      "Next": "Stage13_ConfigApply",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "RollbackManager"
        }
      ]
    },
    "Stage13_ConfigApply": {
      "Type": "Task",
      "Resource": "${ConfigApplierArn}",
      "Next": "Stage14_RoleProvision",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "RollbackManager"
        }
      ]
    },
    "Stage14_RoleProvision": {
      "Type": "Task",
      "Resource": "${RoleProvisionerArn}",
      "Next": "Phase5_DeployAndRun_Marker",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "RollbackManager"
        }
      ]
    },

    "Phase5_DeployAndRun_Marker": {
      "Type": "Pass",
      "Comment": "Phase 5: DEPLOY & RUN - DITL, Cutover & Validation",
      "Result": {
        "phase": 5,
        "phase_name": "DEPLOY_AND_RUN",
        "description": "DITL, Cutover & Validation"
      },
      "ResultPath": "$.phase_telemetry",
      "Next": "Stage15_DITLTestGeneration"
    },

    "Stage15_DITLTestGeneration": {
      "Type": "Task",
      "Resource": "${TestGeneratorArn}",
      "Next": "Stage16_CutoverOrchestration",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "RollbackManager"
        }
      ]
    },
    "Stage16_CutoverOrchestration": {
      "Type": "Task",
      "Resource": "${CutoverOrchestratorArn}",
      "Next": "Stage17_MigrationValidator",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "RollbackManager"
        }
      ]
    },
    "Stage17_MigrationValidator": {
      "Type": "Task",
      "Resource": "${MigrationValidatorArn}",
      "Next": "MigrationComplete",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "RollbackManager"
        }
      ]
    },

    "MigrationComplete": {
      "Type": "Succeed",
      "Comment": "All 17 stages across 5 phases completed successfully"
    },

    "RollbackManager": {
      "Type": "Task",
      "Resource": "${RollbackManagerArn}",
      "End": true
    }
  }
}