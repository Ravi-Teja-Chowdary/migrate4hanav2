# ═══════════════════════════════════════════════════════════════════
# Migrate4HANA — Environment Variables
# ═══════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in the values for your environment.
# Lines starting with # are comments. Uncomment to override defaults.

# ── API Server ────────────────────────────────────────────────────
# M4H_JWT_SECRET=            # JWT signing key (auto-generated to .jwt_secret if empty)
# M4H_API_KEY=               # API key for X-API-Key header auth
# M4H_CORS_ORIGINS=*         # Comma-separated allowed origins
# M4H_HOST=0.0.0.0           # Bind address
# M4H_PORT=8000              # Bind port
# M4H_WORKERS=1              # Uvicorn worker count
# M4H_SSL_KEY=               # Path to TLS private key (optional)
# M4H_SSL_CERT=              # Path to TLS certificate (optional)

# ── AWS / Lambda ──────────────────────────────────────────────────
# AWS_DEFAULT_REGION=us-east-1
# S3_STAGING_BUCKET=migrate4hana-staging-dev
# SECRETS_ARN=               # AWS Secrets Manager ARN for ECC credentials
# S4_SECRETS_ARN=            # AWS Secrets Manager ARN for S/4HANA credentials
# RULES_TABLE_NAME=sap-simplification-rules   # DynamoDB table for rules

# ── ECS / Step Functions ──────────────────────────────────────────
# STAGE_TARGET=              # Handler to run: discovery-engine | code-analyzer | data-loader
# SFN_TASK_TOKEN=            # Step Functions callback token (set by ContainerOverrides)
# SFN_INPUT={}               # JSON event payload (set by ContainerOverrides)
# AWS_LOG_GROUP=/ecs/migrate4hana

# ── SAP RFC ───────────────────────────────────────────────────────
# RFC_CALL_TIMEOUT_SECONDS=120
# RFC_PAGE_SIZE=5000

# ── Data Loader ───────────────────────────────────────────────────
# IDEMPOTENCY_TABLE=migrate4hana-idempotency
# FINS_MAX_POLLS=480         # Max FINS polling attempts (~4h at 30s)
# FINS_POLL_INTERVAL=30      # Base polling interval in seconds
# DMS_REPLICATION_TASK_ARN=  # AWS DMS task ARN (cutover stage)
# CDC_LATENCY_THRESHOLD_SEC=30

# ── Data Hygiene ──────────────────────────────────────────────────
# BP_VALIDATION_HALT_PCT=10.0
# BP_FUZZY_THRESHOLD=0.82
# BP_NUMBER_RANGE_STRATEGY=CUSTOMER_PRIORITY
# BP_VENDOR_OFFSET=5000000000
# BP_CUSTOMER_OFFSET=5000000000
# BP_INTERNAL_START=3000000000
# ENTITY_RESOLUTION_WORKFLOW_ARN=   # AWS Entity Resolution (optional)

# ── Code Analyzer / GenAI ────────────────────────────────────────
# BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0
# LOCAL_LLM_ENDPOINT=        # Air-gapped LLM endpoint (optional)
# AST_CHANGE_THRESHOLD=3

# ── Telemetry / WebSocket ────────────────────────────────────────
# TELEMETRY_WS_ENDPOINT=     # API Gateway WebSocket URL
# TELEMETRY_WS_CONNECTIONS_TABLE=   # DynamoDB table for WS connections

# ── Alerts ────────────────────────────────────────────────────────
# SNS_ALERT_TOPIC_ARN=       # SNS topic for pipeline alerts
# ROLLBACK_BATCH_SIZE=25

# ── Testing (optional — only for live SAP integration tests) ─────
# SAP_TEST_HOST=
# SAP_TEST_SYSNR=00
# SAP_TEST_CLIENT=100
# SAP_TEST_USER=
# SAP_TEST_PASSWD=
# M4H_API_TOKEN=             # JWT token for load tests
