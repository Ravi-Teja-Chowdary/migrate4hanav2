# ──────────────────────────────────────────────────────────────
# Migrate4HANA — Environment Configuration
# ──────────────────────────────────────────────────────────────

# Azure Authentication (via Managed Identity in production)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Azure Storage (Blob)
AZURE_STORAGE_ACCOUNT_NAME=stmigrate4hanadev
AZURE_STORAGE_CONTAINER=staging

# Azure Cosmos DB
AZURE_COSMOSDB_ENDPOINT=https://cosmos-migrate4hana-dev.documents.azure.com:443/
AZURE_COSMOSDB_KEY=

# Azure Key Vault
AZURE_KEYVAULT_URI=https://kv-migrate4hana-dev.vault.azure.net/

# Azure Web PubSub (telemetry)
AZURE_WEB_PUBSUB_CONNECTION_STRING=
AZURE_WEB_PUBSUB_HUB=telemetry

# GenAI — Claude Opus 4.6
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-6-20250219

# Air-gapped LLM (GPU VM)
LOCAL_LLM_ENDPOINT=
LLM_MODE=auto

# SAP ECC Connection
ECC_HOST=
ECC_SYSNR=00
ECC_CLIENT=100
ECC_USER=
ECC_PASS=

# SAP S/4HANA Connection
S4_HOST=
S4_SYSNR=00
S4_CLIENT=100
S4_USER=
S4_PASS=

# Database Migration
ECC_DB_HOST=
ECC_DB_PORT=30015
ECC_DB_NAME=
S4_DB_HOST=
S4_DB_PORT=30015
S4_DB_NAME=

# Pipeline
AST_CHANGE_THRESHOLD=3
RULES_TABLE_NAME=simplification-rules
IDEMPOTENCY_TABLE=idempotency

# Frontend
VITE_API_BASE_URL=http://localhost:8000
VITE_TELEMETRY_WS_URL=
